tools/venv/
tools/adbkey/
__pycache__/
launcher/.gradle/
launcher/build/
launcher/app/build/
launcher/local.properties
# your own TV's dumps (serial, android_id, device names) stay local
backup/
# session screenshots and working notes (may show the Wi-Fi name or account avatar) stay local
shots/
work/*
# "Your TV, Your Way": the setup files are published, everything else in work/ stays local
!work/README.md
!work/*.sh
!work/*.py
!work/debloat.txt
!work/group*.txt
!work/theme-doom/
work/theme-doom/*
!work/theme-doom/config.json
!work/moods/
work/moods/*
!work/moods/titles.json
!work/moods/titles-research*.json
# Perfetto traces from tools/trace.py: large, and they hold the TV's process list
traces/
.DS_Store

# Generated install bundles and JVM crash reports stay out of contributions.
*.apk
*.aab
launcher/hs_err_pid*.log
launcher/replay_pid*.log

# Studio and brand artwork (TMDB posters and backdrops, wallpapers, white app logos) is not redistributed:
# work/make_moods.py and work/make_logos.py rebuild it locally.
launcher/app/src/main/assets/moods/posters/
launcher/app/src/main/assets/moods/backdrops/
launcher/app/src/main/res/drawable-nodpi/banner_logo_*.png

# This TV's own values, kept out of the repo: name and weather location (overrides my_home.xml in release
# builds) and the TV's address (read by work/build-and-install.sh and work/restore.sh).
launcher/app/src/release/res/values/my_personal.xml
